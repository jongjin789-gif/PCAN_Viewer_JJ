FormatVersion=6.0 // Do not edit this line!
Title="Untitled"

{ENUMS}
Enum=ECM_Locking(0="Unlocking", 1="Locking")
Enum=VtSig_R_ST1_MOTOR_OVERSPEED_FAUL(1="Fault", 0="None")
Enum=VtSig_R_ST1_DERATING(1="Derating", 0="Normal")
Enum=VtSig_R_ST1_READY(1="Run", 0="Idle")
Enum=VtSig_R_ST1_MOTOR_DIRECTION(1="Right", 0="Left")
Enum=VtSig_R_ST1_GEAR(2="Reverse", 1="Forward", 0="Neutral")
Enum=VtSig_R_ST1_ECO(1="Activated", 0="Not_activated")
Enum=VtSig_R_ST1_EABS(1="Active", 0="Inactive")
Enum=VtSig_R_ST1_DRVMODE(2="Mode3", 1="Mode2", 0="Mode1")
Enum=VtSig_R_ST1_DIR_ROT(1="CW", 0="CCW")
Enum=VtSig_R_CMD_CONTROL_MODE(12="RpmMode", 10="TorqueMode", 5="ThrottleMode", 0="None")
Enum=VtSig_R_CMD_CONTACTOR(1="Short", 0="Open")
Enum=VtSig_R_CMD_CAN_GEAR_CTRL(1="Valid", 0="Invalid")
Enum=VtSig_R_CMD_CAN_BRAKE(1="Brake", 0="No_Brake")

{SENDRECEIVE}

[ECU_STR_SYS_CMD]
ID=500h
CycleTime=10
Var=B00_Alive_Counter unsigned 0,4
Var=B04_ECM_Locking_L_Stat unsigned 4,2 /max:1 /e:ECM_Locking
Var=B06_ECM_Locking_R_Stat unsigned 6,2 /max:1 /e:ECM_Locking
Var=B08_VCU_Control_Mode unsigned 8,2
Var=B12_VCU_StrCtrl_Mode unsigned 12,4
Var=B16_Control_ECM_L unsigned 16,2
Var=B18_ControlMode_L unsigned 18,2
Var=B20_VehicleSpeed_L unsigned 20,16 /u:Km/h /f:0.01
Var=B40_Control_ECM_R unsigned 40,2
Var=B42_ControlMode_R unsigned 42,2
Var=B44_VehicleSpeed_R unsigned 44,16 /u:Km/h /f:0.01

[ECU_STR_L_ANGLE_CMD]
ID=501h
CycleTime=10
Var=B00_ECM_L_Angle_CMD signed 0,16 /u:deg /f:0.01
Var=B16_Str_L_AngVel_En unsigned 16,1
Var=B20_ECM_L_Ang_Vel unsigned 20,10 /u:deg/s /max:1
Var=B30_ECM_L_Ang_Acc unsigned 30,10 /u:deg/s^2 /max:1
Var=B40_ECM_L_Ang_Dec unsigned 40,10 /u:deg/s^2 /max:1

[ECU_STR_R_ANGLE_CMD]
